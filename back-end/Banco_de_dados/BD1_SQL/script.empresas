banco_dados_populado.itens_vendas CREATE TABLE IF NOT EXISTS `itens_vendas` (
`id_venda` int(11) NOT NULL, `id_item` int(11) NOT NULL, `id_produto` int(11) NOT NULL,
`preco` decimal(10,2) NOT NULL, `quantidade` int(11) NOT NULL, `total_item` decimal(10,2)
NOT NULL, PRIMARY KEY (`id_venda`,`id_item`), KEY `id_produto` (`id_produto`),
CONSTRAINT `itens_vendas_ibfk_1` FOREIGN KEY (`id_venda`) REFERENCES `vendas`
(`id_venda`), CONSTRAINT `itens_vendas_ibfk_2` FOREIGN KEY (`id_produto`)
REFERENCES `produtos` (`id_produto`) ) ENGINE=InnoDB DEFAULT CHARSET=latin1
COLLATE=latin1_swedish_ci; -- Copiando dados para a tabela
